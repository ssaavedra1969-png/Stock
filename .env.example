# ============================================================
# GRUPO FALPAT SRL - Stock de Materiales
# Copia este archivo como ".env.local" y completa los valores.
#
# IMPORTANTE: estos valores se usan SOLO del lado del servidor
# (API Routes de Next.js). NO van con prefijo NEXT_PUBLIC_ y
# nunca llegan al navegador.
# ============================================================

# Repositorio de GitHub donde vive el archivo data/db.json
# (formato: usuario/repo). Ahí se guardan todos los datos.
GITHUB_REPO=TU-USUARIO/TU-REPO

# Personal Access Token con permiso "Contents: Read and write"
# restringido SOLO a ese repositorio.
#
# Como crearlo (recomendado, fine-grained):
# 1. GitHub > Settings > Developer settings > Fine-grained tokens
# 2. New token > Repository access: "Only select repositories" > elegí el repo
# 3. Permissions > Repository permissions > Contents: Read and write
# 4. Copiá el token (empieza con "github_pat_")
GITHUB_TOKEN=github_pat_XXX_XXXXXXXX

# Rama del repositorio (opcional, por defecto "main")
GITHUB_BRANCH=main
